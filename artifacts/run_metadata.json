{
  "seed": 42,
  "config": {
    "version": "0.1.0",
    "seed": 42,
    "unit": {
      "keys": [
        "market_id",
        "commodity_id",
        "currency"
      ],
      "time_key": "month"
    },
    "horizon_months": 1,
    "price_bases": [
      {
        "name": "nominal_within_currency",
        "value_column": "price",
        "currency_scoped": true
      },
      {
        "name": "usdprice",
        "value_column": "usdprice",
        "currency_scoped": false
      }
    ],
    "categories": {
      "include": [
        "cereals and tubers",
        "pulses and nuts",
        "oil and fats",
        "meat, fish and eggs",
        "miscellaneous food"
      ],
      "exclude": [
        "non-food"
      ]
    },
    "target_return_stress": {
      "name": "y1_return_stress",
      "return_transform": "log",
      "standardise": "trailing",
      "trailing_window_months": 12,
      "min_prior_returns": 6,
      "threshold_sd": 1.0,
      "threshold_grid_sd": [
        0.5,
        0.75,
        1.0,
        1.25,
        1.5,
        2.0
      ]
    },
    "target_peer_stress": {
      "name": "y2_peer_stress",
      "peer_group": [
        "commodity_id",
        "currency",
        "month"
      ],
      "peer_stat": "median",
      "min_peer_markets": 5,
      "min_peer_grid": [
        3,
        5,
        10
      ],
      "threshold_spi": 1.2,
      "threshold_grid_spi": [
        1.1,
        1.2,
        1.3,
        1.5
      ]
    },
    "rainfall": {
      "source": "raw/yr.nc",
      "variable": "precip",
      "spatial_agg": "district_zonal_mean",
      "climatology_start": "1981-01",
      "climatology_end": "2015-12",
      "anomaly": "z_score_by_district_calendar_month",
      "lags_months": [
        1,
        2,
        3
      ],
      "rolling_sum_months": [
        3
      ]
    },
    "panel": {
      "min_series_months_for_supervised": 6,
      "flag_priceflag_aggregate": true
    },
    "validation": {
      "scheme": "expanding_window",
      "n_folds": 5,
      "holdout_months": 12
    },
    "optuna": {
      "enabled": true,
      "n_trials": 40,
      "sampler_seed": 42,
      "models": [
        "hist_gradient_boosting"
      ]
    }
  },
  "tasks": [
    "T1_usd_y1",
    "T2_usd_y2",
    "T3_nominal_y1",
    "T4_nominal_y2"
  ],
  "features_numeric": [
    "ret_z_cur",
    "ret_lag1",
    "ret_lag2",
    "ret_roll3",
    "spi",
    "peer_count",
    "rain_anom_z",
    "rain_anom_lag1",
    "rain_anom_lag2",
    "rain_anom_lag3",
    "rain_roll3_mm",
    "month_sin",
    "month_cos",
    "log_population",
    "interaction"
  ],
  "features_categorical": [
    "category",
    "currency"
  ],
  "tuning": {
    "T1_usd_y1": {
      "hist_gradient_boosting": {
        "params": {
          "learning_rate": 0.07500118950416987,
          "max_iter": 100,
          "max_leaf_nodes": 41,
          "min_samples_leaf": 18,
          "l2_regularization": 0.0018205657658407262,
          "max_bins": 255
        },
        "n_trials": 10,
        "source": "artifacts/optuna_best_T1_usd_y1_hist_gradient_boosting.json"
      }
    },
    "T2_usd_y2": {
      "hist_gradient_boosting": {
        "params": {
          "learning_rate": 0.01351182947645082,
          "max_iter": 150,
          "max_leaf_nodes": 9,
          "min_samples_leaf": 26,
          "l2_regularization": 0.03586816498627549,
          "max_bins": 255
        },
        "n_trials": 10,
        "source": "artifacts/optuna_best_T2_usd_y2_hist_gradient_boosting.json"
      }
    },
    "T3_nominal_y1": {
      "hist_gradient_boosting": {
        "params": {
          "learning_rate": 0.07500118950416987,
          "max_iter": 100,
          "max_leaf_nodes": 41,
          "min_samples_leaf": 18,
          "l2_regularization": 0.0018205657658407262,
          "max_bins": 255
        },
        "n_trials": 10,
        "source": "artifacts/optuna_best_T3_nominal_y1_hist_gradient_boosting.json"
      }
    },
    "T4_nominal_y2": {
      "hist_gradient_boosting": {
        "params": {
          "learning_rate": 0.01351182947645082,
          "max_iter": 150,
          "max_leaf_nodes": 9,
          "min_samples_leaf": 26,
          "l2_regularization": 0.03586816498627549,
          "max_bins": 255
        },
        "n_trials": 10,
        "source": "artifacts/optuna_best_T4_nominal_y2_hist_gradient_boosting.json"
      }
    }
  },
  "tuning_objective": "mean validation-block ROC-AUC across expanding-window folds (training period only)"
}